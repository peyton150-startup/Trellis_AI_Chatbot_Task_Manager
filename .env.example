DATABASE_URL=postgresql://trellis:trellis@localhost:55432/trellis
TRELLIS_API_ORIGIN=http://127.0.0.1:8000
MODEL_ID=z-ai/glm-5.2
NVIDIA_API_KEY=
ACTOR_ID=00000000-0000-0000-0000-000000000001
DEMO_UNSAFE_PROMPT_MODE=false
APP_ENV=dev
BLAST_RADIUS_THRESHOLD=3
TOOL_TIMEOUT_SECONDS=20
MODEL_TIMEOUT_SECONDS=45
MAX_TOOL_RETRIES=2
APPROVAL_TTL_SECONDS=300
LEASE_TTL_SECONDS=120

# T00W, the native Linear bridge. See D-69 and D-70.
#
# One hostname, validated at startup as a bare HTTPS origin. Both public URLs
# derive from it, so the OAuth redirect and the webhook URL cannot disagree:
#   <origin>/api/linear/oauth/callback
#   <origin>/api/linear/webhook
TRELLIS_PUBLIC_ORIGIN=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# The single Linear human authorized to operate Trellis as the demo actor.
# Obtain this out of band and never from the first webhook. See the README.
# A personal Linear API key is never used by this application.
LINEAR_ALLOWED_USER_ID=
LINEAR_OAUTH_STATE_TTL_SECONDS=600
# Linear's own guidance is roughly one minute. Configurable so a deterministic
# test can pin it, not so an operator can widen the replay window.
LINEAR_WEBHOOK_FRESHNESS_SECONDS=60
LINEAR_INBOX_LEASE_SECONDS=120
LINEAR_INBOX_MAX_ATTEMPTS=5
LINEAR_HTTP_TIMEOUT_SECONDS=15
